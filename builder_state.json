        {
          "id": "button_1",
          "kind": "button",
          "x": 92,
          "y": 321,
          "width": 244,
          "height": 31,
          "instruction": "url box 1 에 있는 주소에서 문서를 읽어서 md 파일로 변환한 다음 dir box 1 에 있는 주소에 저장한다. \nimage 파일이 있을 경우, 다음과 같이 동작한다. \n radio button 1 이 on 일 경우 :  image 파일을 알아서 분류하여 저장한다. \nradio button 2 가 on 일 경우 : claude 에게 요청하여  image 파일을 분류하여 저장한다\n\n이 버튼이 눌러졌을 경우 팝업 창이 떠서 md file 이름을 사용자가 입력할 수 있도록 한다. 디폴트 파일 명은 output.md 이다",
          "code": "def on_event(self):\n    filename, ok = QInputDialog.getText(\n        self, \"MD 파일 이름\", \"저장할 md 파일 이름을 입력하세요:\", text=\"output.md\"\n    )\n    if not ok or not filename.strip():\n        return\n    filename = filename.strip()\n    if not filename.lower().endswith(\".md\"):\n        filename = filename + \".md\"\n\n    url = self.urlbox_1.text().strip()\n    save_dir = self.dirbox_1.text().strip()\n\n    if not url:\n        QMessageBox.information(self, \"오류\", \"URL을 입력해주세요.\")\n        return\n    if not save_dir:\n        QMessageBox.information(self, \"오류\", \"저장할 디렉토리를 입력해주세요.\")\n        return\n\n    make_dir(save_dir)\n\n    try:\n        html = fetch_url(url)\n    except Exception as e:\n        QMessageBox.information(self, \"오류\", f\"문서를 가져오는 중 오류가 발생했습니다: {e}\")\n        return\n\n    md = html_to_markdown(html)\n\n    save_path = save_dir.rstrip(\"/\") + \"/\" + filename\n    write_file(save_path, md)\n\n    images = extract_images(html, url)\n    saved_count = 0\n    if images and (self.radiobutton_1.isChecked() or self.radiobutton_2.isChecked()):\n        images_dir = save_dir.rstrip(\"/\") + \"/images\"\n        make_dir(images_dir)\n        for i, img in enumerate(images):\n            img_url = img[\"url\"]\n            ext = img_url.split(\"?\")[0].rsplit(\".\", 1)[-1]\n            if not ext or len(ext) > 5:\n                ext = \"png\"\n            temp_name = f\"image_{i}.{ext}\"\n            temp_path = images_dir + \"/\" + temp_name\n            try:\n                download_file(img_url, temp_path)\n            except Exception:\n                continue\n            saved_count += 1\n\n            if self.radiobutton_2.isChecked():\n                topic = classify_image_with_claude(temp_path)\n                topic_dir = images_dir + \"/\" + topic\n                make_dir(topic_dir)\n                move_file(temp_path, topic_dir + \"/\" + temp_name)\n\n    if self.radiobutton_1.isChecked():\n        QMessageBox.information(\n            self, \"이미지 처리\", f\"이미지 {saved_count}개를 images 폴더에 저장했습니다.\"\n        )\n    elif self.radiobutton_2.isChecked():\n        QMessageBox.information(\n            self, \"이미지 처리\", f\"이미지 {saved_count}개를 Claude가 분류한 폴더에 저장했습니다.\"\n        )\n\n    QMessageBox.information(self, \"완료\", f\"{save_path} 에 저장되었습니다.\")",
          "text": "URL 에서 파일을 가져와서 md 로 변환",
          "color": "#aaaaff",
          "font_family": null,
          "font_size": null,
          "group": null,
          "no_border": false,
          "anchor": null,
          "parent_id": "rect_group_2",
          "checked": null
        },
